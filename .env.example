# Copy this file to .env and fill in your values. .env is gitignored.
ANTHROPIC_API_KEY=
# Only required if your key is an "identity-linked" Console key rather than
# a workspace-scoped one -- the API will tell you if you need it.
ANTHROPIC_WORKSPACE_ID=

# Optional overrides -- see README.md for defaults.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_EFFORT=medium
# AUTO_CONFIRM_RISKY=false
# MOCK_BANK_APP_PORT=4000
# OPERATOR_PORT=4100

# Teller credentials for the local fake app. Used only by the sign-on steps:
# never shown to the AI, never written to capabilities or logs.
CU_TELLER_ID=teller01
CU_TELLER_PASSWORD=Legacy-Demo-2026!
